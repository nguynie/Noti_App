# Telegram Bot credentials
# 1. Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 2. Get TELEGRAM_CHAT_ID from @userinfobot or your channel ID (e.g., 123456789 or -1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here

# Facebook session cookies (Optional but recommended for reliability)
# Copy the full "Cookie" header from browser DevTools (Network tab on facebook.com)
# Example: c_user=1000...; xs=...; datr=...;
FB_COOKIES=

# Polling configuration
# Interval in seconds between check cycles (e.g., 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300
# Random delay in seconds between scanning consecutive pages (prevents rate limits)
REQUEST_DELAY_SECONDS=3
# Mark existing posts on initial launch without sending notifications
AUTO_BASELINE_FIRST_RUN=true
